{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/primitivas/dinero/**/*.ts",
    "src/primitivas/cantidad/**/*.ts",
    "src/primitivas/identificacion-fiscal/**/*.ts",
    "src/primitivas/domicilio/**/*.ts",
    "src/primitivas/tiempo/**/*.ts",
    "src/primitivas/resultado/**/*.ts",
    "src/contexto/estados.ts",
    "src/modulos/fiscal/dominio/**/*.ts",
    "src/modulos/tenants/dominio/**/*.ts",
    "src/modulos/empresas/dominio/**/*.ts",
    "src/modulos/identidad/dominio/**/*.ts",
    "src/plataforma/dominio/**/*.ts",
    "src/consultas-de-grupo/vista-de-grupo.ts",
    "src/adaptadores/postgres/huella-canonica.ts",
    "src/adaptadores/trabajos/reintentos.ts",
    "src/adaptadores/trabajos/error-seguro.ts",
    "src/adaptadores/correo/configuracion.ts",
    "src/capacidades/permisos/**/*.ts",
    "src/capacidades/modulos/**/*.ts",
    "src/primitivas/identificadores/**/*.ts",
    "src/capacidades/planes/**/*.ts",
    "src/capacidades/vocabulario/**/*.ts",
    "src/modulos/planes/dominio/**/*.ts",
    "src/modulos/marcas/dominio/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 100
  },
  "ignorePatterns": [".claude", "reports", ".stryker-tmp"]
}
