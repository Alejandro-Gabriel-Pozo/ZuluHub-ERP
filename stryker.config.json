{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "ZULUHUB_SIN_INTEGRACION=1 npx vitest run --project node --reporter=dot $ZULUHUB_FILTRO_PRUEBAS"
  },
  "mutate": [
    "src/primitivas/dinero/**/*.ts",
    "src/primitivas/cantidad/**/*.ts",
    "src/primitivas/identificacion-fiscal/**/*.ts",
    "src/primitivas/domicilio/**/*.ts",
    "src/primitivas/tiempo/**/*.ts",
    "src/primitivas/resultado/**/*.ts",
    "src/contexto/estados.ts",
    "src/modulos/fiscal/dominio/**/*.ts",
    "src/modulos/tenants/dominio/**/*.ts",
    "src/modulos/empresas/dominio/**/*.ts",
    "src/modulos/identidad/dominio/**/*.ts",
    "src/plataforma/dominio/**/*.ts",
    "src/consultas-de-grupo/vista-de-grupo.ts",
    "src/adaptadores/postgres/huella-canonica.ts",
    "src/adaptadores/postgres/describir-falla-de-base.ts",
    "src/adaptadores/postgres/roles-de-la-aplicacion.ts",
    "src/adaptadores/vercel/**/*.ts",
    "src/adaptadores/trabajos/reintentos.ts",
    "src/adaptadores/trabajos/error-seguro.ts",
    "src/adaptadores/correo/configuracion.ts",
    "src/capacidades/permisos/**/*.ts",
    "src/capacidades/modulos/**/*.ts",
    "src/primitivas/identificadores/**/*.ts",
    "src/capacidades/planes/**/*.ts",
    "src/capacidades/vocabulario/**/*.ts",
    "src/modulos/planes/dominio/**/*.ts",
    "src/modulos/marcas/dominio/**/*.ts",
    "src/capacidades/experiencia/**/*.ts",
    "src/capacidades/activos/**/*.ts",
    "src/capacidades/controles/**/*.ts",
    "src/primitivas/contacto/**/*.ts",
    "src/composicion/entorno.ts",
    "src/composicion/perezoso.ts",
    "src/composicion/contextos.ts",
    "src/plataforma/captacion/dominio/**/*.ts",
    "src/modulos/fiscal/consultas/criterios-de-listado.ts",
    "src/capacidades/autenticacion/**/*.ts",
    "src/adaptadores/autenticacion/configuracion.ts",
    "src/composicion/ruta-de-ingreso.ts",
    "!src/**/*.test.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 100
  },
  "ignorePatterns": [".claude", "reports", ".stryker-tmp"]
}
