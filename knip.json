{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/**/*.ts", "test/**/*.test.ts", "neon.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "arquitectura/**/*.cjs"],
      "ignoreDependencies": ["@stryker-mutator/command-runner", "@types/react-dom", "next"]
    },
    "apps/web": {
      "entry": ["servidor/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignoreIssues": {
    "arquitectura/lint-sql.cjs": ["exports"]
  }
}
