{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // `arquitectura/deuda/*.cjs`: el control de deuda lo lanzan el CLI y la prueba por `require` (que knip no
      // sigue): sus funciones exportadas son su interfaz de prueba, no código muerto. Lo mismo `arquitectura/grupos-de-mutacion.cjs`
      // (lo cargan `stryker.config.mjs`, el planificador y su prueba por `require`): como entrada, sus exportaciones no cuentan
      // como muertas y no hace falta una excepción nueva en `ignoreIssues` (que sumaría deuda).
      "entry": [
        "src/**/*.ts",
        "test/**/*.test.ts",
        "test/**/*.recorrido.ts",
        "neon.ts",
        "arquitectura/deuda/*.cjs",
        "arquitectura/grupos-de-mutacion.cjs"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "arquitectura/**/*.cjs"],
      "ignoreDependencies": ["@stryker-mutator/command-runner"],
      // `openssl`: lo llama la fachada https del recorrido (`test/recorrido/apoyo/fachada-https.ts`) para generar su certificado
      // autofirmado; viene con el sistema de cualquier runner de Ubuntu y no es una dependencia del proyecto.
      "ignoreBinaries": ["openssl"]
    },
    "apps/web": {
      "entry": ["servidor/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/plataforma": {
      "entry": ["servidor/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignoreIssues": {
    "arquitectura/lint-sql.cjs": ["exports"],
    // Los lee la prueba por `createRequire`, que knip no sigue: lo usa el registro de contratos que todavía no existe.
    "arquitectura/contratos/detectores.cjs": ["exports"],
    // Los lee la prueba de la matriz por `createRequire`, que knip no sigue (misma razón que `detectores.cjs`).
    "arquitectura/contratos/invariantes.cjs": ["exports"],
    "arquitectura/contratos/verificar-mecanismo.cjs": ["exports"],
    // Lo permitido en una clase excluida y su revisión los leen las pruebas por `createRequire`, que knip no
    // sigue (misma razón que `detectores.cjs`); `no-debilitar.cjs` también vigila la lista.
    "arquitectura/contratos/clasificacion.cjs": ["exports"],
    // `segmentoARegexp` se exporta solo para probar el escapado directo (la prueba la lee por `createRequire`;
    // `@public` no alcanza en un módulo CommonJS).
    "arquitectura/contratos/globs.cjs": ["exports"],
    // La batería de evasión y las pruebas del guardián leen sus constantes y `evaluarResultado` por `require`,
    // que knip no sigue (misma razón que `detectores.cjs`).
    "arquitectura/contratos/evasiones.cjs": ["exports"]
  }
}
