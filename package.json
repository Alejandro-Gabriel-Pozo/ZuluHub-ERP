{
  "name": "pedernal-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pedernal: ERP multiempresa. Reglas y decisiones en el repositorio Pedernal-docs.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/plataforma/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project node",
    "test:componentes": "vitest run --project componentes",
    "arquitectura": "depcruise src apps scripts --config .dependency-cruiser.cjs",
    "analizar:muerto": "knip",
    "mutacion": "stryker run",
    "migrar": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/migrar-base.ts",
    "instalar-clave": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/instalar-clave-de-contexto.ts",
    "build:web": "npm run build --workspace @pedernal/web",
    "build:plataforma": "npm run build --workspace @pedernal/plataforma",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm run arquitectura && npm run analizar:muerto && npm test",
    "plataforma:primer-admin": "node --import ./scripts/cargador-de-ts.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/crear-primer-admin.ts",
    "plataforma:caso": "node --import ./scripts/cargador-de-ts.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/ejecutar-caso-de-plataforma.ts",
    "plataforma:baja-admin": "node --import ./scripts/cargador-de-ts.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/baja-de-admin.ts",
    "plataforma:resetear-segundo-factor": "node --import ./scripts/cargador-de-ts.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/resetear-segundo-factor.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.8.6",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.14.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.2",
    "knip": "^6.41.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "asn1js": "3.0.10",
    "better-auth": "1.7.7",
    "fast-xml-parser": "5.11.2",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pkijs": "3.4.1",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
